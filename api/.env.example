APP_NAME="Autevo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

# Who is allowed to say, in X-Forwarded-For, where a request really came from.
# The loopback covers a proxy on this machine: nginx in production, cloudflared
# in testing. Widen it only to an address that cannot be reached from outside.
TRUSTED_PROXIES=127.0.0.1,::1
APP_LOCALE=mk
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marketplace
DB_USERNAME=marketplace
DB_PASSWORD=secret
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Any S3-compatible provider: set the endpoint for anything that is not AWS.
AWS_ENDPOINT=
# The public hostname photographs are served from. Without it every photo URL
# points at the private endpoint and no picture loads.
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false


# Rate limits. Every route is throttled; config/rate_limits.php says why each
# ceiling is where it is. Raise them here without touching code.
RATE_LIMIT_SIGNED_IN=120
RATE_LIMIT_SIGNED_OUT=300
RATE_LIMIT_SEARCH_SIGNED_IN=40
RATE_LIMIT_SEARCH_SIGNED_OUT=90

OTP_DRIVER=log

# Only read when OTP_DRIVER=discord. Posts each sign-in code to a Discord
# channel instead of sending it, for handing a build to friends before an
# aggregator is paid for. Everyone who can read the channel can sign in as any
# number in it, and the number is not masked there — empty this before anybody
# real signs in.
OTP_DISCORD_WEBHOOK_URL=

# A six-digit code that verifies ANY number, for handing a test build to
# people without relaying a code to each of them. Anyone who can reach the API
# can then sign in as anybody, so it is refused when APP_ENV=production, every
# use is logged, and it must be empty before a real user touches this. Pick
# something unguessable rather than 123456.
OTP_UNIVERSAL_CODE=
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE=otp_code

REVENUECAT_WEBHOOK_SECRET=

PUSH_DRIVER=log
FCM_PROJECT_ID=
# The service account JSON. Defaults to storage/app/firebase.json.
FCM_CREDENTIALS=
# The .p8 downloaded from Apple. Defaults to storage/app/apns.p8.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=mk.autevo.app
APNS_PRODUCTION=false

RATES_DRIVER=none
RATES_URL=
RATES_KEY=
