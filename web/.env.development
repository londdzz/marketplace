# Loaded by Vite in dev only; the production build takes VITE_API_URL from the
# deploy. Without this the dev server talks to the live API, which is not what
# anyone running `npm run dev` means.
#
# Point it at the API however you reach it: `php artisan serve` on this machine,
# or your PC's own address as docs/local-api-on-windows.md describes.
VITE_API_URL=http://127.0.0.1:8000/api/v1

# Where the apps live, once each store has published one. Empty here on
# purpose: the phone gate dims a badge it has no link for rather than drawing
# a button that goes nowhere. Set these in the host's environment (Cloudflare
# Pages, or the Forge site) when the apps are live.
# VITE_IOS_APP_URL=https://apps.apple.com/mk/app/autevo/id0000000000
# VITE_ANDROID_APP_URL=https://play.google.com/store/apps/details?id=mk.autevo.app

# Serves the website to a telephone instead of the download screen. For
# testing the site itself on a phone; never set in production.
# VITE_MOBILE_GATE=off
