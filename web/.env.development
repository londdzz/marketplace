# Loaded by Vite in dev only; the production build takes VITE_API_URL from the
# deploy. Without this the dev server talks to the live API, which is not what
# anyone running `npm run dev` means.
#
# Point it at the API however you reach it: `php artisan serve` on this machine,
# or your PC's own address as docs/local-api-on-windows.md describes.
VITE_API_URL=http://127.0.0.1:8000/api/v1
