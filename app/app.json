{
  "expo": {
    "name": "vetura",
    "slug": "vetura",
    "scheme": "vetura",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#1E4FD8",
    "icon": "./assets/icon.png",
    "backgroundColor": "#F6F8FA",
    "locales": {
      "en": "./locales/en.json",
      "mk": "./locales/mk.json"
    },
    "ios": {
      "bundleIdentifier": "mk.vetura.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleLocalizations": ["mk", "en"],
        "CFBundleDevelopmentRegion": "mk",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "mk.vetura.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#1E4FD8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      ["expo-router", { "root": "./src/app" }],
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#1E4FD8",
          "dark": { "backgroundColor": "#0B0F15" }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1E4FD8"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "vetura needs your photo library so you can choose pictures of the car you are selling.",
          "cameraPermission": "vetura uses the camera so you can photograph the car you are selling."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    },
    "owner": "vetura"
  }
}
