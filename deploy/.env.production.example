# Production environment for the Autevo API.
#
# Copy to /home/forge/api.autevo.mk/api/.env on the server and fill in every blank.
# Nothing in here belongs in git: the real file stays on the server only.
#
# docs/deployment.md walks through where each value comes from.
# PLACEHOLDERS.md says what breaks while one is still empty.

APP_NAME="Autevo"
APP_ENV=production
# php artisan key:generate --force writes this. Never reuse the dev key.
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
# No trailing slash. Storage and anything else generating a URL reads this.
APP_URL=https://api.autevo.mk
APP_LOCALE=mk
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=autevo
DB_USERNAME=autevo
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# Photographs live in object storage in production, never on the server's own
# disk: the server is disposable and the photographs are not.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=autevo-photos
AWS_DEFAULT_REGION=auto
# Cloudflare R2: https://<account id>.r2.cloudflarestorage.com
AWS_ENDPOINT=
# The public hostname photographs are served from. Without it every photo URL
# points at the private endpoint and no picture ever loads.
AWS_URL=https://img.autevo.mk
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Sign-in ---------------------------------------------------------------
# NEVER ship `log`: it writes codes to the log and sends nothing, so anyone
# who can read the log can sign in as anyone.
OTP_DRIVER=whatsapp
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE=otp_code

# --- Purchases -------------------------------------------------------------
# The same string set in RevenueCat. Empty means every delivery is rejected,
# so no purchase ever grants a credit.
REVENUECAT_WEBHOOK_SECRET=

# --- Push ------------------------------------------------------------------
PUSH_DRIVER=stores
FCM_PROJECT_ID=
FCM_CREDENTIALS=/home/forge/api.autevo.mk/api/storage/app/firebase.json
APNS_KEY_PATH=/home/forge/api.autevo.mk/api/storage/app/apns.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=mk.autevo.app
# false is Apple's sandbox. TestFlight and the App Store both need true.
APNS_PRODUCTION=true

# --- Exchange rates --------------------------------------------------------
# Only needed when a market that does not use the euro opens. `none` leaves
# the seeded rates alone.
RATES_DRIVER=none
RATES_URL=
RATES_KEY=

MAIL_MAILER=log
